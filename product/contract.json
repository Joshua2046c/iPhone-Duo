  "assembly_story": {
    "installation": "后盖半片置入三边敞口浅托壳，以可移除薄胶垫固定；另一半沿 +Y 自由开合；Joy-Con 从上端沿两侧槽形滑轨向下插入。",
    "maintenance": "左右随形上盖各以两根开槽方桩连接下壳方孔，止退肩卡入孔底扩腔；从端部逐步解开卡接取下上盖，检修声腔和音量机构。柔性传导组件与底壳一体打印；保留Joy-Con释放按钮操作空间。",
    "user_access": [
      "内屏",
      "顶部原机音量键",
      "右侧双音量按钮",
      "摄像头",
      "Joy-Con 释放按钮",
      "USB-C",
      "左盖板双出声槽"
    ]
  },
